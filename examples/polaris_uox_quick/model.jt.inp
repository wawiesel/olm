=polaris
% --------------------------------------------------------------------------------------------
%  parameters are: {{state.enrichment}}      - wt% U235
%                  {{state.coolant_density}} - coolant density (g/cc)
%                  {{state.specific_power}}  - average specific power (MW/MTHM)
%                  {{comp.density}}          - fuel density (g/cc)
% --------------------------------------------------------------------------------------------
% Documentation and Notes:
%  [Change Log]
%    Rev 1: Generated by M. Jessee (${SCALE}/samples/input/polaris_bwr7x7.inp)
%    Rev 2: Polaris model parameterized for OLM by S. Skutnik, November 2025
%  [Author(s)] M. Jessee, S. Skutnik
%  [SCALE Version] SCALE 6.3.3
%  [Reactor Type] Boiling Water Reactor, simple 7x7 lattice
%  [Model Info] 2D Polaris full assembly model, {{static.xslib}} cross-section library
%  [Sources]
{% for key, src in _.model.sources.items() -%}
%    [{{key}}] {{src}}
{% endfor -%}
%  [Power]
%    {{state.specific_power}} MW/MTU specific power
%  [Other Info]
{%- for nb in _.model.notes %}
%    {{nb}}
{%- endfor %}
title "{{_.model.description}}"
lib "{{static.xslib}}"
% ------------------------------------ %
% geometry
% ------------------------------------ %
sys BWR
geom bwr7x7 : ASSM 7 1.88
hgap  0.47498 0.9525 : 2 2 : 3 4
box 0.2032 0.9652 6.72224
% ------------------------------------ %
% comps/mats
% ------------------------------------ %
{%- for var_fr in static.enr_variants %}
comp {{"c_enrU{0:d}".format(loop.index)}} : UOX enr={{"{0:.4f}".format(state.enrichment*var_fr)}}
{%- endfor %}
comp gad     : WT GD2O3={{state.wtpt_gd}} c_enrU1=-100
{%- for var_fr in static.enr_variants %}
mat {{"FUEL.{0:d}".format(loop.index)}} : {{"c_enrU{0:d}".format(loop.index)}} {{comp.density}}
{%- endfor %}
mat FUEL.5 : gad      10.19
% ------------------------------------ %
% pins
% ------------------------------------ %
{% set idstring="ABCD" %}
{%- for i in range(static.enr_variants|length) -%}
pin {{idstring[i]}} : 0.61 0.62 0.715
      : {{"FUEL.{0:d}".format(i+1)}} GAP.1 CLAD.1
{% endfor -%}
pin G :   0.61 0.62 0.715
      : FUEL.5  GAP  CLAD
mesh FUEL.5 : nr=10
pinmap
D
C B
C A G
B A A A
B A A A G
B A G A A A
C B A A A B B
% ------------------------------------ %
% state conditions
% ------------------------------------ %
state FUEL : temp=900
      COOL : dens={{state.coolant_density|round(4,"common")}}
pow {{state.specific_power}}
bu {%- for bu_val in time.gwd_burnups %} {{bu_val}}
{%- endfor %}
% ------------------------------------ %
% run-time simplifications
% ------------------------------------ %
shield ALL=N
opt DEPL TrackingSet='none' Method='predictor'
opt KEFF NumPolar=1 NumAzim=1 UpscatterSuperGroup=56 CyclicRay=no EigSolver='POWER'
opt ESSM NumPolar=1 NumAzim=1
end
