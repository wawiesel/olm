{
    "model": {
        "name": "polaris_uox_quick",
        "description": "Generic BWR 7x7 Polaris lattice",
        "template_float_format": ".12e",
        "sources": {
            "Godfrey 2014": "Andrew T. Godfrey, ``VERA core physics benchmark progression problem specifications, Consortium for Advanced Simulation of LWRs'', 2014",
            "Radulescu 2021": "Georgeta Radulescu, Brandon R. Grogan, and Kaushik Banerjee, ``Fuel Assembly Reference Information for SNF Radiation Source Term Calculations,'' ORNL/SPR-2021/2093, Oak Ridge National Laboratory, 2021",
            "OCRWM 1987": "U.S. DOE Office of Civilian Radioactive Waste Management, ``Characteristics of spent fuel, high-level waste, and other radioactive wastes which may require long-term isolation: Appendix 2A, Physical descriptions of LWR (Light-Water Reactor) fuel assemblies,'' DOI: 10.2172/5258301, 1987"
        },
        "revision": [
            "1.0"
        ],
        "notes": [
            "General dimensions from References [Radulescu 2021] and [OCRWM 1987].",
            "U-235 enrichment formula from Reference [Godfrey 2014].",
            "Parameterized input based on polaris_bwr7x7.inp SCALE sample problem."
        ]
    },
    "generate": {
        "_type": "scale.olm.generate.root:jt_expander",
        "template": "model/polaris/bwr7x7-uox.jt.inp",
        "artifact_contract": "Polaris",
        "comp": {
            "_type": "scale.olm.generate.comp:uo2_simple",
            "density": 10.4
        },
        "static": {
            "_type": "scale.olm.generate.static:pass_through",
            "xslib": "broad_lwr",
            "enr_variants": [
                1.171,
                0.775,
                0.675,
                0.531
            ]
        },
        "states": {
            "_type": "scale.olm.generate.states:full_hypercube",
            "coolant_density": [
                0.10,
                0.30,
                0.60,
                0.75
            ],
            "enrichment": [
                1.0,
                2.0,
                3.0
            ],
            "wtpt_gd": [
                3.0
            ],
            "specific_power": [
                25.0
            ]
        },
        "time": {
            "_type": "scale.olm.generate.static:pass_through",
            "gwd_burnups": [
                0.5,
                1.0,
                5.0,
                10.0,
                25.0,
                50.0,
                60.0,
                70.0
            ]
        }
    },
    "run": {
        "_type": "scale.olm.run:makefile",
        "dry_run": false
    },
    "assemble": {
        "_type": "scale.olm.assemble:arpdata_txt",
        "fuel_type": "UOX",
        "dim_map": {
            "mod_dens": "coolant_density",
            "enrichment": "enrichment"
        },
        "keep_every": 1,
        "material_lumping": "BASIS"
    },
    "check": {
        "_type": "scale.olm.check:sequencer",
        "sequence": [
            {
                "_type": "scale.olm.check:LowOrderConsistency",
                "name": "loc",
                "template": "model/origami/lumped0d-uox.jt.inp",
                "target_q_r": 0.70,
                "target_q_ar": 0.95,
                "eps0": 1e-12,
                "epsa": 1e-6,
                "epsr": 1e-3,
                "nuclide_compare": [
                    "u235",
                    "pu239",
                    "pu240",
                    "pu241",
                    "pu242",
                    "am241",
                    "pu238",
                    "u234",
                    "u238",
                    "cs134",
                    "cs137",
                    "nd148",
                    "eu154",
                    "am242m",
                    "am243",
                    "cm242",
                    "cm244"
                ]
            }
        ]
    },
    "report": {
        "_type": "scale.olm.report:rst2pdf",
        "template": "report/scale-short.jt.rst"
    }
}
